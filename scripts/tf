#!/usr/bin/env bash
# Run terraform in a stack directory with a Cloudflare token.
# Usage: scripts/tf <stack> <terraform args...>   e.g. scripts/tf cloudflare plan
#
# Token precedence: CLOUDFLARE_API_TOKEN from the environment, otherwise the wrangler OAuth
# login (~/.config/.wrangler). The OAuth token lives one hour; a cheap wrangler call refreshes it.
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
stack="${1:?usage: scripts/tf <stack> <terraform args...>}"
shift
[ -d "$root/$stack" ] || { echo "unknown stack: $stack" >&2; exit 2; }

if [ -z "${CLOUDFLARE_API_TOKEN:-}" ]; then
  cfg="${XDG_CONFIG_HOME:-$HOME/.config}/.wrangler/config/default.toml"
  [ -f "$cfg" ] || { echo "no CLOUDFLARE_API_TOKEN and no wrangler login (run: bunx wrangler login)" >&2; exit 1; }
  read_field() { sed -n "s/^$1 = \"\(.*\)\"$/\1/p" "$cfg"; }
  expires="$(read_field expiration_time)"
  if [ -z "$expires" ] || [ "$(date -d "$expires" +%s)" -le "$(( $(date +%s) + 300 ))" ]; then
    CLOUDFLARE_ACCOUNT_ID=93b84e890d66e1c2c6890b27c1e3b96b bunx wrangler r2 bucket list >/dev/null
  fi
  CLOUDFLARE_API_TOKEN="$(read_field oauth_token)"
  export CLOUDFLARE_API_TOKEN
fi

exec terraform -chdir="$root/$stack" "$@"
